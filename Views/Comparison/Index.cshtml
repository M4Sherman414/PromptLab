@using PromptLab.Services
@model PromptLab.Models.ViewModels.ComparisonCreateViewModel
@{
    ViewData["Title"] = "Karşılaştırma";
    var modelGroups = Model.ActiveModels
        .GroupBy(m => m.IsFree)
        .OrderByDescending(g => g.Key)
        .ToList();
}

<div class="mx-auto" style="max-width: 960px;">
    <div class="mb-4">
        <h1 class="h3 mb-1">Tekli Karşılaştırma</h1>
        <p class="text-muted mb-0">
            Aynı prompt'u iki modele paralel gönderin, cevapları yan yana karşılaştırın.
        </p>
    </div>

    @if (!Model.HasUsableKey)
    {
        <div class="alert alert-warning">
            @(Model.KeyStatus == ApiKeyStatus.Invalid
                ? "Kayıtlı anahtarınız OpenRouter tarafından tanınmıyor (401). Karşılaştırma başlatmak için"
                : "Karşılaştırma başlatabilmek için önce")
            <a asp-controller="ApiKey" asp-action="Index" asp-route-returnUrl="@Url.Action("Index", "Comparison")"
               class="alert-link">API anahtarınızı</a> kaydetmelisiniz.
        </div>
    }

    @if (TempData["Error"] is string tempError)
    {
        <div class="alert alert-danger">@tempError</div>
    }

    @if (Model.ActiveModels.Count < 2)
    {
        <div class="alert alert-warning">
            Karşılaştırma yapabilmek için en az 2 aktif model bulunmalıdır. Admin panelinden modelleri senkronize edip aktifleştirebilirsiniz.
        </div>
    }
    else
    {
        <form asp-action="Create" method="post" id="comparison-form" class="card shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ModelAId" class="form-label fw-semibold"></label>
                        <select asp-for="ModelAId" class="form-select">
                            <option value="">Model A seçin…</option>
                            @foreach (var group in modelGroups)
                            {
                                <optgroup label="@(group.Key ? "Ücretsiz modeller" : "Ücretli modeller ($ / 1M tokens: input / output)")">
                                    @foreach (var m in group)
                                    {
                                        <option value="@m.Id">
                                            @m.DisplayName@(m.IsFree ? "" : $" — ${m.InputPricePerMillion:0.##} / ${m.OutputPricePerMillion:0.##}")
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <span asp-validation-for="ModelAId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ModelBId" class="form-label fw-semibold"></label>
                        <select asp-for="ModelBId" class="form-select">
                            <option value="">Model B seçin…</option>
                            @foreach (var group in modelGroups)
                            {
                                <optgroup label="@(group.Key ? "Ücretsiz modeller" : "Ücretli modeller ($ / 1M tokens: input / output)")">
                                    @foreach (var m in group)
                                    {
                                        <option value="@m.Id">
                                            @m.DisplayName@(m.IsFree ? "" : $" — ${m.InputPricePerMillion:0.##} / ${m.OutputPricePerMillion:0.##}")
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <span asp-validation-for="ModelBId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="UserPrompt" class="form-label fw-semibold"></label>
                    <textarea asp-for="UserPrompt" class="form-control" rows="4"
                              placeholder="İki modele de göndermek istediğiniz prompt'u yazın…"></textarea>
                    <span asp-validation-for="UserPrompt" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="collapse" data-bs-target="#comparison-options"
                            aria-expanded="@((!string.IsNullOrWhiteSpace(Model.SystemPrompt) || Model.Temperature.HasValue || Model.MaxTokens.HasValue) ? "true" : "false")">
                        <i class="bi bi-sliders me-1"></i>Gelişmiş parametreler (System prompt, Temperature, Max tokens)
                    </button>
                </div>

                <div class="collapse @((!string.IsNullOrWhiteSpace(Model.SystemPrompt) || Model.Temperature.HasValue || Model.MaxTokens.HasValue) ? "show" : "")"
                     id="comparison-options">
                    <div class="border rounded p-3 bg-light mb-3">
                        <div class="mb-3">
                            <label asp-for="SystemPrompt" class="form-label"></label>
                            <textarea asp-for="SystemPrompt" class="form-control" rows="2"
                                      placeholder="Örn. Kısa ve Türkçe yanıt ver."></textarea>
                            <span asp-validation-for="SystemPrompt" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Temperature" class="form-label"></label>
                                <input asp-for="Temperature" type="number" step="0.1" min="0" max="2"
                                       class="form-control" placeholder="Varsayılan (0.0 – 2.0)" />
                                <div class="form-text">Düşük değerler daha tutarlı, yüksek değerler daha yaratıcı yanıt üretir.</div>
                                <span asp-validation-for="Temperature" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaxTokens" class="form-label"></label>
                                <input asp-for="MaxTokens" type="number" step="1" min="1" max="128000"
                                       class="form-control" placeholder="Varsayılan (ör. 1024)" />
                                <div class="form-text">Model başına üretilebilecek en fazla çıkış token sayısı.</div>
                                <span asp-validation-for="MaxTokens" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center gap-2">
                    <button type="submit" class="btn btn-primary px-4" id="compare-submit" disabled="@(!Model.HasUsableKey)">
                        <span class="spinner-border spinner-border-sm d-none me-1" id="compare-spinner" aria-hidden="true"></span>
                        <i class="bi bi-layout-split me-1" id="compare-icon"></i>
                        <span id="compare-label">Karşılaştır</span>
                    </button>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById("comparison-form");
            if (!form) return;

            const modelA = document.getElementById("ModelAId");
            const modelB = document.getElementById("ModelBId");
            const submitBtn = document.getElementById("compare-submit");
            const spinner = document.getElementById("compare-spinner");
            const icon = document.getElementById("compare-icon");
            const label = document.getElementById("compare-label");

            function validateDifferentModels() {
                if (!modelA || !modelB) return true;
                if (modelA.value && modelB.value && modelA.value === modelB.value) {
                    modelB.setCustomValidity("Karşılaştırma için iki farklı model seçmelisiniz.");
                    return false;
                }
                modelB.setCustomValidity("");
                return true;
            }

            modelA?.addEventListener("change", validateDifferentModels);
            modelB?.addEventListener("change", validateDifferentModels);

            form.addEventListener("submit", function (e) {
                if (!validateDifferentModels()) {
                    e.preventDefault();
                    modelB.reportValidity();
                    return;
                }

                if (typeof $ !== "undefined" && typeof $(form).valid === "function" && !$(form).valid()) {
                    return;
                }

                if (submitBtn) {
                    submitBtn.disabled = true;
                    spinner?.classList.remove("d-none");
                    icon?.classList.add("d-none");
                    if (label) label.textContent = "Yanıtlar bekleniyor…";
                }
            });
        })();
    </script>
}
