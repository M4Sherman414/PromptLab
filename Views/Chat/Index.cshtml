@using PromptLab.Models.ViewModels
@model ChatHistoryViewModel
@{
    ViewData["Title"] = "Sohbetlerim";
}

@section Styles {
    <link rel="stylesheet" href="~/css/comparison.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Sohbetlerim</h1>
        <p class="text-muted mb-0">Geçmiş sohbetlerinize ve model karşılaştırmalarınıza buradan dönebilirsiniz.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" asp-route-mode="compare" class="btn btn-outline-secondary">
            <i class="bi bi-layout-split me-1"></i> Yeni karşılaştırma
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Yeni sohbet
        </a>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<div class="alert alert-danger d-none" id="history-error" role="alert"></div>

@if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-chat-left-text fs-1 text-muted d-block mb-3"></i>
            <h2 class="h5">Henüz sohbet veya karşılaştırmanız yok</h2>
            <p class="text-muted mb-3">Aktif modellerden seçerek ilk sohbetinizi veya karşılaştırmanızı başlatın.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Başla</a>
        </div>
    </div>
}
else
{
    <div class="mb-3" id="history-filter-wrap">
        <div class="mode-switch" role="group" aria-label="Geçmiş filtresi" id="history-filter">
            <button type="button" class="mode-switch-btn active" data-filter="all">
                Tümü (<span data-count="all">@Model.Items.Count</span>)
            </button>
            <button type="button" class="mode-switch-btn" data-filter="chat">
                <i class="bi bi-chat-dots me-1"></i>Sohbetler (<span data-count="chat">@Model.ChatCount</span>)
            </button>
            <button type="button" class="mode-switch-btn" data-filter="comparison">
                <i class="bi bi-layout-split me-1"></i>Karşılaştırmalar (<span data-count="comparison">@Model.ComparisonCount</span>)
            </button>
        </div>
    </div>

    <div class="list-group shadow-sm" id="history-list">
        @foreach (var item in Model.Items)
        {
            var isComparison = item.Kind == HistoryItemKind.Comparison;
            var filterKind = isComparison ? "comparison" : "chat";
            var controller = isComparison ? "Comparison" : "Chat";
            var action = isComparison ? "Result" : "Session";
            var confirmText = isComparison
                ? "Bu karşılaştırmayı silmek istediğinize emin misiniz?"
                : "Bu sohbeti ve tüm mesajlarını silmek istediğinize emin misiniz?";

            <div class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center gap-3"
                 data-kind="@filterKind">
                <a asp-controller="@controller" asp-action="@action" asp-route-id="@item.Id"
                   class="flex-grow-1 min-w-0 text-decoration-none text-reset">
                    <div class="d-flex align-items-center gap-2 mb-1 min-w-0">
                        <span class="badge @(isComparison ? "text-bg-light border text-dark" : "text-bg-light border text-secondary") flex-shrink-0">
                            <i class="bi @(isComparison ? "bi-layout-split" : "bi-chat-dots") me-1"></i>@(isComparison ? "Karşılaştırma" : "Sohbet")
                        </span>
                        <span class="fw-semibold text-truncate">@item.Title</span>
                    </div>
                    <div class="small text-muted text-truncate">
                        <i class="bi bi-cpu me-1"></i>@item.ModelSummary
                        @if (item.IsFreeOnly)
                        {
                            <span class="badge bg-success ms-1">Ücretsiz</span>
                        }
                        @if (item.IsPending)
                        {
                            <span class="badge text-bg-warning ms-1">Bekliyor</span>
                        }
                        else if (item.HasError)
                        {
                            <span class="badge text-bg-danger ms-1">Hata</span>
                        }
                    </div>
                </a>

                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <small class="text-muted text-nowrap">
                        @item.ActivityAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </small>
                    <form asp-controller="@controller" asp-action="Delete" asp-route-id="@item.Id"
                          method="post" class="d-inline history-delete-form" data-confirm="@confirmText">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil" aria-label="Sil">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="card d-none" id="history-empty-filter">
        <div class="card-body text-center py-4 text-muted">
            Bu kategoride henüz kayıt bulunmuyor.
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const filter = document.getElementById("history-filter");
            const list = document.getElementById("history-list");
            const emptyState = document.getElementById("history-empty-filter");
            const errorBox = document.getElementById("history-error");
            if (!filter || !list) return;

            const buttons = filter.querySelectorAll(".mode-switch-btn");
            let activeFilter = "all";

            function applyFilter() {
                const rows = list.querySelectorAll("[data-kind]");
                let visibleCount = 0;
                let chatCount = 0;
                let comparisonCount = 0;

                rows.forEach(function (row) {
                    const kind = row.dataset.kind;
                    if (kind === "chat") chatCount++;
                    if (kind === "comparison") comparisonCount++;

                    const show = activeFilter === "all" || kind === activeFilter;
                    row.classList.toggle("d-none", !show);
                    if (show) visibleCount++;
                });

                const setCount = (k, val) => {
                    const el = filter.querySelector('[data-count="' + k + '"]');
                    if (el) el.textContent = val;
                };
                setCount("all", chatCount + comparisonCount);
                setCount("chat", chatCount);
                setCount("comparison", comparisonCount);

                list.classList.toggle("d-none", visibleCount === 0);
                emptyState?.classList.toggle("d-none", visibleCount > 0);
            }

            buttons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    activeFilter = btn.dataset.filter;
                    buttons.forEach(b => b.classList.toggle("active", b === btn));
                    applyFilter();
                });
            });

            list.addEventListener("submit", async function (e) {
                const form = e.target.closest(".history-delete-form");
                if (!form) return;

                e.preventDefault();
                const msg = form.dataset.confirm || "Silmek istediğinize emin misiniz?";
                if (!window.confirm(msg)) return;

                if (errorBox) errorBox.classList.add("d-none");
                const btn = form.querySelector("button[type=submit]");
                if (btn) btn.disabled = true;

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    if (!response.ok) {
                        let data = null;
                        try { data = await response.json(); } catch (_) { }
                        throw new Error((data && data.error) || "Kayıt silinemedi (" + response.status + ").");
                    }

                    const row = form.closest("[data-kind]");
                    row?.remove();
                    applyFilter();
                } catch (err) {
                    if (btn) btn.disabled = false;
                    if (errorBox) {
                        errorBox.textContent = err.message || "Silme sırasında bir hata oluştu.";
                        errorBox.classList.remove("d-none");
                    }
                }
            });
        })();
    </script>
}
