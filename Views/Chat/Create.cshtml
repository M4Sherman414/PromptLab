@model PromptLab.Models.ViewModels.NewChatViewModel
@{
    ViewData["Title"] = "Yeni sohbet";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Yeni sohbet</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Sohbetlerime dön</a>
</div>

@if (Model.ActiveModels.Count == 0)
{
    <div class="alert alert-warning">
        Şu anda aktif model bulunmuyor. Admin panelinden modelleri senkronize edip aktifleştirdikten sonra sohbet başlatabilirsiniz.
    </div>
}
else
{
    <div class="card shadow-sm" style="max-width: 640px;">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="SelectedModelId" class="form-label"></label>
                    <select asp-for="SelectedModelId" class="form-select">
                        <option value="">-- Model seçin --</option>
                        @foreach (var m in Model.ActiveModels)
                        {
                            <option value="@m.Id">
                                @m.DisplayName (@m.OpenRouterModelId)@(m.IsFree ? " - Ücretsiz" : "")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="SelectedModelId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SystemPrompt" class="form-label"></label>
                    <textarea asp-for="SystemPrompt" class="form-control" rows="3"
                              placeholder="Örn: Yanıtları kısa ve Türkçe ver."></textarea>
                    <span asp-validation-for="SystemPrompt" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Sohbeti başlat</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
