@using PromptLab.Models
@model ChatSession
@{
    ViewData["Title"] = Model.Title;
    var hasApiKey = ViewBag.HasApiKey as bool? ?? true;
    var modelName = Model.ModelCatalog?.DisplayName ?? "Asistan";
    ViewData["ModelName"] = modelName;

    // Ana sayfadan gelen ilk mesaj: chat.js sayfa açılınca otomatik gönderir.
    var pendingPrompt = TempData["PendingPrompt"] as string;
    if (!hasApiKey) { pendingPrompt = null; }
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

<div class="chat-page">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div class="text-truncate">
            <h1 class="h4 mb-1 text-truncate" id="chat-title">@Model.Title</h1>
            <div class="small text-muted">
                <i class="bi bi-cpu me-1"></i>@modelName
                <code class="ms-1">@Model.ModelCatalog?.OpenRouterModelId</code>
                @if (Model.ModelCatalog?.IsFree == true)
                {
                    <span class="badge bg-success ms-1">Ücretsiz</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-ul me-1"></i>Sohbetlerim
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Yeni sohbet
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Bu sohbeti ve tüm mesajlarını silmek istediğinize emin misiniz?');">
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Sohbeti sil">
                    <i class="bi bi-trash me-1"></i>Sil
                </button>
            </form>
        </div>
    </div>

    @* Sohbet toplamları: JavaScript her yeni cevapta yeniden hesaplar. *@
    <div class="chat-summary small text-muted mb-3" id="chat-summary">
        <span><i class="bi bi-chat-dots"></i> <strong data-total="turns">0</strong> yanıt</span>
        <span><i class="bi bi-box-arrow-in-right"></i> <strong data-total="input">0</strong> input tokens</span>
        <span><i class="bi bi-box-arrow-right"></i> <strong data-total="output">0</strong> output tokens</span>
        <span><i class="bi bi-stopwatch"></i> avg latency <strong data-total="latency">0</strong> ms</span>
        <span><i class="bi bi-currency-dollar"></i> cost <strong data-total="cost">0</strong></span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SystemPrompt))
    {
        <div class="alert alert-light border small mb-3">
            <strong>System prompt:</strong> @Model.SystemPrompt
        </div>
    }

    @if (!hasApiKey)
    {
        <div class="alert alert-warning">
            @(ViewBag.KeyStatus is PromptLab.Services.ApiKeyStatus.Invalid
                ? "Kayıtlı anahtarınız OpenRouter tarafından tanınmıyor (401). Mesaj gönderebilmek için"
                : "Mesaj gönderebilmek için önce")
            <a asp-controller="ApiKey" asp-action="Index" asp-route-returnUrl="@Context.Request.Path"
               class="alert-link">API anahtarınızı</a> kaydetmelisiniz.
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="alert alert-danger d-none" id="chat-error" role="alert"></div>

    <div class="chat-messages" id="chat-messages">
        <div class="chat-empty text-muted text-center py-4 @(Model.Messages.Count > 0 ? "d-none" : "")" id="chat-empty">
            <i class="bi bi-chat-left-text fs-3 d-block mb-2"></i>
            Sohbete başlamak için aşağıdan ilk mesajınızı gönderin.
        </div>

        @foreach (var msg in Model.Messages.OrderBy(m => m.CreatedAt).ThenBy(m => m.Id))
        {
            <partial name="_ChatMessage" model="msg" view-data="ViewData" />
        }

        @* Cevap beklenirken gösterilen geçici balon. *@
        <div class="chat-row chat-row-assistant d-none" id="chat-typing">
            <div class="chat-bubble">
                <div class="chat-author">@modelName</div>
                <div class="chat-typing">
                    <span></span><span></span><span></span>
                    <small class="text-muted ms-2">yazıyor…</small>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="SendMessage" asp-route-id="@Model.Id" method="post" class="chat-input" id="chat-form"
          data-autosend="@(string.IsNullOrEmpty(pendingPrompt) ? "false" : "true")">
        <textarea name="prompt" id="chat-prompt" class="form-control" rows="1" maxlength="20000"
                  placeholder="Mesajınızı yazın… (Enter: gönder, Shift+Enter: yeni satır)"
                  required disabled="@(!hasApiKey)">@pendingPrompt</textarea>
        <button type="submit" class="btn btn-primary" id="chat-send" disabled="@(!hasApiKey)">
            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            <i class="bi bi-send"></i>
            <span class="d-none d-sm-inline ms-1">Gönder</span>
        </button>
    </form>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
