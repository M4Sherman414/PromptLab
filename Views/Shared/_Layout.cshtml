<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROMPT Lab</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            color: #212529;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        .sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #ffffff;
            border-right: 1px solid #e9ecef;
        }

        .sidebar .nav-link {
            color: #333333;
            font-weight: 500;
            padding: 0.6rem 0.8rem;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar .nav-link:hover {
            background-color: #f1f3f5;
            color: #000000;
        }

        .sidebar .nav-link.active {
            background-color: #e9ecef;
            color: #000000;
        }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
    </style>
</head>
<body>

    <div class="d-flex">
        <!-- Mobil Menü Açma Butonu (Sadece mobilde görünür) -->
        <div class="d-lg-none position-fixed top-0 start-0 p-3 z-3">
            <button class="btn btn-light border shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                <i class="bi bi-list fs-4"></i>
            </button>
        </div>

        <!-- Sidebar (Masaüstü Sabit / Mobil Offcanvas) -->
        <div class="offcanvas-lg offcanvas-start sidebar d-flex flex-column p-3" tabindex="-1" id="sidebarOffcanvas">
            <!-- Logo / Başlık -->
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <span class="fw-bold fs-5 tracking-wide">PROMPT Lab</span>
            </div>

            <!-- Navigasyon Linkleri -->
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link active">
                        <i class="bi bi-plus-lg fs-5"></i>
                        <span>New chat</span>
                    </a>
                </li>
                <hr class="my-2 text-secondary opacity-25">
                <li class="nav-item mb-1">
                    <a href="#" class="nav-link">
                        <i class="bi bi-star fs-5"></i>
                        <span>Leaderboard</span>
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="#" class="nav-link">
                        <i class="bi bi-cpu fs-5"></i>
                        <span>Models</span>
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="#" class="nav-link">
                        <i class="bi bi-chat-left-text fs-5"></i>
                        <span>Chats</span>
                    </a>
                </li>
            </ul>

            <hr class="my-2 text-secondary opacity-25">

            <!-- Kullanıcı Hesabı -->
            <div class="pt-2">
                <a href="#" class="nav-link">
                    <i class="bi bi-person-circle fs-5"></i>
                    <span>Account</span>
                </a>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="main-content">
            <main role="main" class="container-fluid p-4 p-lg-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>