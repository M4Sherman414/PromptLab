@using PromptLab.Services
@model PromptLab.Models.ViewModels.NewChatViewModel
@{
    var isCompare = string.Equals(Model.Mode, "compare", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = Model.IsSignedIn ? (isCompare ? "Karşılaştırma" : "Yeni sohbet") : "PROMPT Lab";
    var needsKey = Model.IsSignedIn && !Model.HasUsableKey;
    var modelGroups = Model.ActiveModels
        .GroupBy(m => m.IsFree)
        .OrderByDescending(g => g.Key)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/comparison.css" asp-append-version="true" />
}

@*
    Ana sayfa üç durumda farklı görünür:
    1) Giriş yapılmamış  → ürün tanıtımı + kayıt/giriş
    2) Anahtar yok/geçersiz → tek adımlık kurulum kartı
    3) Hazır             → Yeni sohbet / Karşılaştırma kutusu
*@

@if (!Model.IsSignedIn)
{
    <div class="landing">
        <div class="text-center mb-5">
            <span class="badge rounded-pill text-bg-light border mb-3 px-3 py-2">
                <i class="bi bi-lightning-charge me-1"></i>OpenRouter üzerinden yüzlerce LLM
            </span>
            <h1 class="landing-title">Hangi model gerçekten daha iyi?</h1>
            <p class="landing-lead text-muted mx-auto">
                PROMPT Lab'de LLM'lerle sohbet et, aynı prompt'u iki modele birden gönder,
                cevapları kör oyla ve kendi leaderboard'unu oluştur.
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-4">Ücretsiz başla</a>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/" class="btn btn-outline-secondary btn-lg px-4">Giriş yap</a>
            </div>
            <p class="small text-muted mt-3 mb-0">
                <i class="bi bi-shield-lock me-1"></i>Kendi OpenRouter API key'inle çalışır, key şifreli saklanır.
            </p>
        </div>

        <div class="row g-3">
            <div class="col-md-6 col-xl-3">
                <div class="landing-card">
                    <i class="bi bi-chat-dots"></i>
                    <h2>Sohbet</h2>
                    <p>Seçtiğin modelle çok turlu sohbet. Her cevapta input/output tokens, latency ve cost.</p>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="landing-card">
                    <i class="bi bi-layout-split"></i>
                    <h2>Karşılaştırma</h2>
                    <p>Aynı prompt iki modele gider, cevaplar yan yana gösterilir.</p>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="landing-card">
                    <i class="bi bi-incognito"></i>
                    <h2>Blind mode &amp; Elo <span class="badge text-bg-light border">yakında</span></h2>
                    <p>Model adları oydan sonra açılır. Kör oylar Elo puanını günceller.</p>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="landing-card">
                    <i class="bi bi-trophy"></i>
                    <h2>Turnuva <span class="badge text-bg-light border">yakında</span></h2>
                    <p>King of the hill ya da 4/8/16 modellik bracket ile şampiyonu bul.</p>
                </div>
            </div>
        </div>
    </div>
}
else if (needsKey)
{
    var invalid = Model.KeyStatus == ApiKeyStatus.Invalid;
    <div class="new-chat">
        <div class="setup-card mx-auto text-center">
            <div class="setup-icon @(invalid ? "text-danger" : "text-primary")">
                <i class="bi @(invalid ? "bi-key-fill" : "bi-key")"></i>
            </div>
            @if (invalid)
            {
                <h1 class="h4">API key'in OpenRouter tarafından tanınmıyor</h1>
                <p class="text-muted">
                    Kayıtlı key silinmiş ya da hatalı kopyalanmış olabilir (401).
                    Yeni bir key girdiğinde buraya geri döneceksin.
                </p>
            }
            else
            {
                <h1 class="h4">Bir adım kaldı: OpenRouter API key'ini ekle</h1>
                <p class="text-muted">
                    Modellere senin key'inle istek atılır. Key şifreli saklanır ve bir daha ekranda gösterilmez.
                    Ücretsiz modeller için kredi gerekmez.
                </p>
            }
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="ApiKey" asp-action="Index" asp-route-returnUrl="/" class="btn btn-primary">
                    @(invalid ? "Key'i güncelle" : "API key ekle")
                </a>
                <a href="https://openrouter.ai/keys" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">
                    OpenRouter'dan key al <i class="bi bi-box-arrow-up-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="new-chat" id="new-chat-root">
        <h1 class="fw-normal display-6 text-center mb-3" id="new-chat-heading">
            @(isCompare ? "İki modeli yarıştır" : "Nereden başlayalım?")
        </h1>

        <div class="d-flex justify-content-center mb-3">
            <div class="mode-switch" role="group" aria-label="Çalışma modu">
                <button type="button" class="mode-switch-btn @(isCompare ? "" : "active")" data-mode="chat">
                    <i class="bi bi-chat-dots me-1"></i>Sohbet
                </button>
                <button type="button" class="mode-switch-btn @(isCompare ? "active" : "")" data-mode="compare">
                    <i class="bi bi-layout-split me-1"></i>Karşılaştırma
                </button>
            </div>
        </div>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        <div class="alert alert-danger d-none" id="home-error" role="alert"></div>

        @if (Model.ActiveModels.Count == 0)
        {
            <div class="alert alert-warning text-center">
                Şu anda aktif model yok. Admin panelinden modeller senkronize edilip aktifleştirilmeli.
            </div>
        }
        else
        {
            <form asp-controller="Chat" asp-action="Create" method="post" id="new-chat-form"
                  data-chat-action="@Url.Action("Create", "Chat")"
                  data-compare-action="@Url.Action("Create", "Comparison")"
                  data-compare-start="@Url.Action("Start", "Comparison")"
                  data-compare-slot="@Url.Action("RunSlot", "Comparison")">
                <input type="hidden" id="mode-input" value="@(isCompare ? "compare" : "chat")" />

                <div class="new-chat-box shadow-sm">
                    <textarea asp-for="Prompt" id="new-chat-prompt" class="form-control new-chat-input" rows="1"
                              placeholder="Bir şey sor… (Enter: gönder, Shift+Enter: yeni satır)" required></textarea>

                    <div class="collapse" id="system-prompt-box">
                        <textarea asp-for="SystemPrompt" id="SystemPrompt" class="form-control form-control-sm mb-2" rows="2"
                                  placeholder="System prompt, ör. You are a concise assistant. Answer in Turkish."></textarea>

                        <div class="row g-2 mb-2 @(isCompare ? "" : "d-none")" id="compare-params-row">
                            <div class="col-sm-6">
                                <input asp-for="Temperature" id="Temperature" type="number" step="0.1" min="0" max="2"
                                       class="form-control form-control-sm"
                                       placeholder="Temperature (0.0 – 2.0, isteğe bağlı)" />
                            </div>
                            <div class="col-sm-6">
                                <input asp-for="MaxTokens" id="MaxTokens" type="number" step="1" min="1" max="128000"
                                       class="form-control form-control-sm"
                                       placeholder="Maksimum token (ör. 1024, isteğe bağlı)" />
                            </div>
                        </div>
                    </div>

                    <div class="new-chat-toolbar flex-wrap">
                        @* Sohbet modu: tek model seçimi *@
                        <div id="chat-model-picker" class="@(isCompare ? "d-none" : "")" style="max-width: 60%;">
                            <select asp-for="SelectedModelId" class="form-select form-select-sm" aria-label="Model">
                                @foreach (var group in modelGroups)
                                {
                                    <optgroup label="@(group.Key ? "Ücretsiz modeller" : "Ücretli modeller ($ / 1M tokens: input / output)")">
                                        @foreach (var m in group)
                                        {
                                            <option value="@m.Id">
                                                @m.DisplayName@(m.IsFree ? "" : $" — ${m.InputPricePerMillion:0.##} / ${m.OutputPricePerMillion:0.##}")
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        @* Karşılaştırma modu: Model A ve Model B seçimi *@
                        <div id="compare-model-pickers" class="compare-model-pickers @(isCompare ? "" : "d-none")">
                            <select asp-for="ModelAId" id="ModelAId" class="form-select form-select-sm compare-model-select" aria-label="Model A">
                                @foreach (var group in modelGroups)
                                {
                                    <optgroup label="@(group.Key ? "Ücretsiz modeller" : "Ücretli modeller ($ / 1M tokens: input / output)")">
                                        @foreach (var m in group)
                                        {
                                            <option value="@m.Id">
                                                @m.DisplayName@(m.IsFree ? "" : $" — ${m.InputPricePerMillion:0.##} / ${m.OutputPricePerMillion:0.##}")
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span class="compare-vs">vs</span>
                            <select asp-for="ModelBId" id="ModelBId" class="form-select form-select-sm compare-model-select" aria-label="Model B">
                                @foreach (var group in modelGroups)
                                {
                                    <optgroup label="@(group.Key ? "Ücretsiz modeller" : "Ücretli modeller ($ / 1M tokens: input / output)")">
                                        @foreach (var m in group)
                                        {
                                            <option value="@m.Id">
                                                @m.DisplayName@(m.IsFree ? "" : $" — ${m.InputPricePerMillion:0.##} / ${m.OutputPricePerMillion:0.##}")
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap"
                                data-bs-toggle="collapse" data-bs-target="#system-prompt-box" aria-expanded="false">
                            <i class="bi bi-sliders"></i><span class="d-none d-sm-inline ms-1" id="params-toggle-label">@(isCompare ? "Parametreler" : "System prompt")</span>
                        </button>

                        <button type="submit" class="btn btn-primary btn-sm ms-auto" id="new-chat-submit" aria-label="Gönder">
                            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </div>
            </form>

            @* Karşılaştırma gönderildiği anda sayfa yenilenmeden burada açılır *@
            <div class="battle-stage d-none" id="battle-stage">
                <div class="battle-prompt-card">
                    <div class="small text-muted fw-semibold mb-1">Siz</div>
                    <div class="battle-prompt-text" id="battle-prompt-text"></div>
                    <div class="small text-muted mt-2 d-none" id="battle-system-note"></div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6" id="slot-container-A"></div>
                    <div class="col-md-6" id="slot-container-B"></div>
                </div>
            </div>
        }

        <div class="text-center mt-3 small">
            <a asp-controller="Chat" asp-action="Index" class="text-muted">
                <i class="bi bi-chat-left-text me-1"></i>Geçmiş sohbet ve karşılaştırmalarım
            </a>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/comparison.js" asp-append-version="true"></script>
    }
}
