@model List<PromptLab.Models.ChatSession>
@{
    ViewData["Title"] = "Sohbetlerim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Sohbetlerim</h1>
        <p class="text-muted mb-0">Geçmiş sohbetlerinize devam edebilir veya yeni bir sohbet başlatabilirsiniz.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Yeni sohbet
    </a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-chat-left-text fs-1 text-muted d-block mb-3"></i>
            <h2 class="h5">Henüz sohbetiniz yok</h2>
            <p class="text-muted mb-3">Aktif modellerden birini seçerek ilk sohbetinizi başlatın.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Yeni sohbet başlat</a>
        </div>
    </div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var session in Model)
        {
            <a asp-action="Session" asp-route-id="@session.Id" class="list-group-item list-group-item-action py-3">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="text-truncate">
                        <div class="fw-semibold text-truncate">@session.Title</div>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-cpu me-1"></i>
                            @(session.ModelCatalog?.DisplayName ?? "Bilinmeyen model")
                            @if (session.ModelCatalog?.IsFree == true)
                            {
                                <span class="badge bg-success ms-1">Ücretsiz</span>
                            }
                        </div>
                    </div>
                    <small class="text-muted text-nowrap">
                        @session.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
            </a>
        }
    </div>
}
